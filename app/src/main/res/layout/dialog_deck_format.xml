<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/deck_format_description"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <RadioGroup
        android:id="@+id/radioGroupFormat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/radioStandard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/standard_format"
            android:checked="true"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/standard_format_description"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginLeft="32dp"
            android:layout_marginBottom="12dp" />

        <RadioButton
            android:id="@+id/radioExpanded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/expanded_format"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/expanded_format_description"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginLeft="32dp"
            android:layout_marginBottom="12dp" />

    </RadioGroup>

</LinearLayout>

